# Production Environment Variables for PotBot
# Copy this file to .env.prod and fill in your actual values
# 
# IMPORTANT: This project follows TDD practices - see agents.md
# Always run tests before deployment: npm test

# Bot Configuration (Telegram Bot for pooled trading fund)
BOT_TOKEN=your_telegram_bot_token_here
BOT_WEBHOOK_SECRET=your_webhook_secret_min_12_chars
BOT_ADMINS=[123456789,987654321]
BOT_ALLOWED_UPDATES=["message","callback_query"]

# Database Configuration (using trust authentication)
# No password needed - using POSTGRES_HOST_AUTH_METHOD=trust

# Wallet Configuration (for pooled trading fund)
# You can use EITHER a seed phrase OR a private key
# All group wallets are derived from this master wallet
# This controls the shared Solana wallet for each Telegram group
WALLET_MASTER_SEED=your twelve word seed phrase goes here
# OR use private key in one of these formats:
# WALLET_MASTER_SEED=5Jv8...base58...string
# WALLET_MASTER_SEED=[123,45,67,89,...]
# WALLET_MASTER_SEED=0123456789abcdef...

# Encryption key for storing private keys in database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Solana Network (use mainnet for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Let's Encrypt Configuration
LETSENCRYPT_EMAIL=your-email@example.com

# Logging
DEBUG=false
LOG_LEVEL=info
