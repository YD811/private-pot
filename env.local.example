# Local Test Environment Variables
# Copy this file to .env.local and fill in your test values

# Bot Configuration (use test bot token from @BotFather)
BOT_TOKEN=your_test_telegram_bot_token_here
BOT_ADMINS=[123456789]
BOT_ALLOWED_UPDATES=["message","callback_query"]

# Wallet Configuration (use test/dev values - NOT real money!)
WALLET_MASTER_SEED=test twelve word seed phrase for local development only
WALLET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Solana Network (use devnet for testing - NOT mainnet!)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Logging (verbose for local testing)
DEBUG=true
LOG_LEVEL=debug
