# Bot Configuration
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_MODE=polling
BOT_ADMINS=[123456789]
BOT_ALLOWED_UPDATES=[]

# Logging
DEBUG=true
LOG_LEVEL=info

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://potbot:potbot_dev_password@localhost:5432/potbot

# Wallet Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Generate with: npx bip39-cli generate (or use 12-word seed phrase)
WALLET_MASTER_SEED=your twelve word seed phrase goes here for wallet derivation

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Webhook Configuration (only if BOT_MODE=webhook)
# BOT_WEBHOOK=https://your-domain.com/webhook
# BOT_WEBHOOK_SECRET=your-webhook-secret-min-12-chars
# SERVER_HOST=0.0.0.0
# SERVER_PORT=80

WALLET_MASTER_SEED=