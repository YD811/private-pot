# Bot Configuration
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_MODE=polling
BOT_ADMINS=[123456789]
BOT_ALLOWED_UPDATES=[]

# Logging
DEBUG=true
LOG_LEVEL=info

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://potbot:potbot_dev_password@localhost:5432/potbot

# Wallet Configuration
# You can use EITHER a seed phrase OR a private key
# All group wallets are derived from this master wallet
# 
# OPTION 1: Seed Phrase (12 or 24 words)
#   Generate: npx bip39-cli generate
#   Or use your existing Phantom/Solflare seed phrase
WALLET_MASTER_SEED=your twelve word seed phrase goes here
#
# OPTION 2: Private Key (choose one format)
#   Format 1 - Base58 (from Phantom export or solana-keygen):
#   WALLET_MASTER_SEED=5Jv8...base58...string
#
#   Format 2 - Byte Array (from Solana CLI):
#   WALLET_MASTER_SEED=[123,45,67,89,...]
#
#   Format 3 - Hex (128 characters):
#   WALLET_MASTER_SEED=0123456789abcdef...
#
# To export from Phantom:
#   Settings → Security & Privacy → Export Private Key

# Encryption key for storing private keys in database
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Solana Network (devnet for development, mainnet for production)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Operator Fee Wallet (where trading fees are collected)
# This is your wallet address where 0.5% commission from all trades will be sent
# For non-SOL tokens, fees will be sent to the associated token account for this wallet
OPERATOR_FEE_WALLET_ADDRESS=YourSolanaWalletAddressHere

# Webhook Configuration (only if BOT_MODE=webhook)
# BOT_WEBHOOK=https://your-domain.com/webhook
# BOT_WEBHOOK_SECRET=your-webhook-secret-min-12-chars
# SERVER_HOST=0.0.0.0
# SERVER_PORT=80

